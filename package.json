{
  "name": "proto-yupoo-organizer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3090",
    "dev:docker": "docker compose -f docker-compose.dev.yml up next",
    "dev:docker:build": "docker compose -f docker-compose.dev.yml build next",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "catalog:import": "node --experimental-strip-types --experimental-specifier-resolution=node scripts/import-catalog.ts",
    "catalog:embeddings:seed": "node --experimental-strip-types --experimental-specifier-resolution=node scripts/seed-catalog-embeddings.ts",
    "scrape:eval": "node --experimental-strip-types --experimental-specifier-resolution=node scripts/run-yupoo-scrape-eval.ts",
    "scrape:eval:analyze": "node --experimental-strip-types --experimental-specifier-resolution=node scripts/analyze-yupoo-scrape-eval.ts",
    "scrape:eval:compare": "node --experimental-strip-types --experimental-specifier-resolution=node scripts/compare-yupoo-scrape-eval.ts",
    "scrape:eval:loop": "node --experimental-strip-types --experimental-specifier-resolution=node scripts/run-yupoo-scrape-eval-loop.ts",
    "db:types": "supabase gen types typescript --local > src/types/database.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "e2e": "playwright test",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:functions:serve": "supabase functions serve mission-queue --env-file supabase/.env.local",
    "dev:queue": "supabase functions serve mission-queue --env-file supabase/.env.local"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@hookform/resolvers": "^5.2.2",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.99.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.577.0",
    "next": "16.2.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.71.2",
    "react-resizable-panels": "^4.10.0",
    "shadcn": "^4.1.0",
    "sharp": "^0.34.5",
    "sharp-phash": "^2.2.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "jsdom": "^29.0.1",
    "supabase": "^2.83.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "msw",
      "sharp",
      "supabase",
      "unrs-resolver"
    ]
  }
}
